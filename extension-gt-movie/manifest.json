{
  "manifest_version": 3,
  "name": "Gentube Harness - Video",
  "version": "0.1.0",
  "description": "Batch automation for Gentube prompts, generation, and downloads.",
  "permissions": [
    "sidePanel",
    "scripting",
    "downloads",
    "storage"
  ],
  "web_accessible_resources": [
  {
    "resources": [
      "inputimages/*"
    ],
    "matches": ["<all_urls>"]
  }
],
  "host_permissions": [
    "https://www.gentube.app/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Flow Veo Automation"
  },
  "side_panel": {
    "default_path": "side_panel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.gentube.app/*"
      ],
      "js": ["content_script.js"],
      "run_at": "document_idle"
    }
  ]
}
